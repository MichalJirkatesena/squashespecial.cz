# Zkopíruj tento soubor do .env.local a vyplň hodnoty z Firebase konzole.
# Podrobný návod krok za krokem je v SETUP.md.

# --- Firebase web config (Project settings > General > Your apps > Web app) ---
# Tyto hodnoty NEJSOU tajné, používají se i v prohlížeči.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (Project settings > Service accounts > Generate new private key) ---
# TAJNÉ hodnoty ze staženého JSON souboru service account klíče. Nikdy je nesdílej ani nedávej do gitu.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Celý "private_key" ze staženého JSON, včetně -----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
FIREBASE_PRIVATE_KEY=

# --- Vercel Blob (úložiště fotek, nahrazuje Firebase Storage, které vyžaduje placený plán) ---
# Vytvoří se na vercel.com > tvůj projekt > Storage > Create Database > Blob.
# Lokálně: `npx vercel env pull .env.local` po připojení Blob úložiště v dashboardu vyplní tuto hodnotu automaticky.
BLOB_READ_WRITE_TOKEN=
